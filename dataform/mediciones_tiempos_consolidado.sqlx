config {
  type: "table",
  schema: "encuestas",
  name: "mediciones_tiempos_consolidado",
  description: "Mediciones de tiempos de procesos consolidadas: histórico de los Google Forms (Google Sheets IQQ/CJC/PMC) + levantamiento desde la app. Una fila por medición. Hitos: t1 ingreso a la fila, t2 salida de la fila, t3 fin de la atención (solo app; en el histórico NULL).",
  columns: {
    origen: "Origen del dato: 'app' (levantamiento en la app) | 'form_historico' (Google Forms)",
    response_id: "ID único de la medición",
    company_name: "Empresa / aeropuerto",
    location_name: "Sede",
    source: "Origen fino (FIELD/QR_PUBLIC en la app; GOOGLE_FORM en el histórico)",
    responded_at: "Fecha y hora del registro (hora Chile en UTC)",
    version_number: "Versión del cuestionario (NULL en el histórico)",
    process: "Proceso medido (Check in | AVSEC | Retiro de equipajes | ...)",
    checkin_airline: "Aerolínea del check-in",
    checkin_t1: "Check-in: ingreso a la fila",
    checkin_t2: "Check-in: salida de la fila (inicio de la atención)",
    checkin_t3: "Check-in: salida del counter o quiosco (fin de la atención). Solo app; NULL en el histórico",
    checkin_comments: "Check-in: comentarios (incluye N° counters y aerolínea original del histórico)",
    avsec_t1: "AVSEC: ingreso a la fila",
    avsec_t2: "AVSEC: salida de la fila (inicio de la atención)",
    avsec_t3: "AVSEC: salida del control (fin de la atención). Solo app; NULL en el histórico",
    avsec_comments: "AVSEC: comentarios (incluye N° máquinas de rayos X del histórico)",
    baggage_claim_airline: "Retiro de equipaje: aerolínea (estructurada en la app y en el histórico Google Forms)",
    baggage_claim_t1: "Retiro de equipaje: llegada primer pasajero",
    baggage_claim_t2: "Retiro de equipaje: salida primera maleta",
    baggage_claim_t3: "Retiro de equipaje: salida última maleta",
    baggage_claim_comments: "Retiro de equipaje: comentarios (incluye aerolínea del histórico)",
    passport_outbound_t1: "Pasaporte emigración: ingreso a la fila",
    passport_outbound_t2: "Pasaporte emigración: salida de la fila (inicio de la atención)",
    passport_outbound_t3: "Pasaporte emigración: salida del counter (fin de la atención). Solo app; NULL en el histórico",
    passport_outbound_comments: "Pasaporte emigración: comentarios",
    passport_inbound_t1: "Pasaporte inmigración: ingreso a la fila",
    passport_inbound_t2: "Pasaporte inmigración: salida de la fila (inicio de la atención)",
    passport_inbound_t3: "Pasaporte inmigración: salida del counter (fin de la atención). Solo app; NULL en el histórico",
    passport_inbound_comments: "Pasaporte inmigración: comentarios",
    border_protection_t1: "Control aduana / SAG: ingreso a la fila",
    border_protection_t2: "Control aduana / SAG: salida de la fila (inicio de la atención)",
    border_protection_t3: "Control aduana / SAG: salida del control (fin de la atención). Solo app; NULL en el histórico",
    border_protection_comments: "Control aduana / SAG: comentarios"
  },
  tags: ["encuestas"]
}

js {
  // ETAPA DE PRUEBAS: las respuestas de la APP anteriores a esta fecha (hora Chile)
  // son de prueba y NO se consideran. Al salir a producción de verdad, ajusta
  // GO_LIVE a la fecha real de puesta en marcha (o ponla en el pasado, p.ej.
  // "2000-01-01", para incluir todo). El histórico de Google Forms NO se filtra.
  const GO_LIVE = "2026-08-01";
}

-- Unión del levantamiento en la app + el histórico de los Google Forms.
-- El histórico (mediciones_sheets) no tiene el tercer hito de los procesos con fila
-- (solo medía la fila): sus *_t3 van en NULL. Retiro de equipajes sí tiene t3 en ambos.

SELECT
  "app" AS origen,
  response_id, company_name, location_name, source, responded_at, version_number,
  process, checkin_airline, checkin_t1, checkin_t2, checkin_t3, checkin_comments,
  avsec_t1, avsec_t2, avsec_t3, avsec_comments,
  baggage_claim_airline,
  baggage_claim_t1, baggage_claim_t2, baggage_claim_t3, baggage_claim_comments,
  passport_outbound_t1, passport_outbound_t2, passport_outbound_t3, passport_outbound_comments,
  passport_inbound_t1, passport_inbound_t2, passport_inbound_t3, passport_inbound_comments,
  border_protection_t1, border_protection_t2, border_protection_t3, border_protection_comments
FROM ${ref("mediciones_de_tiempos")}
-- Excluye las respuestas de prueba de la app (anteriores a la puesta en marcha).
WHERE responded_at >= TIMESTAMP("${GO_LIVE} 00:00:00", "America/Santiago")

UNION ALL

SELECT
  "form_historico" AS origen,
  response_id, company_name, location_name, source, responded_at, version_number,
  process, checkin_airline, checkin_t1, checkin_t2, CAST(NULL AS TIMESTAMP) AS checkin_t3, checkin_comments,
  avsec_t1, avsec_t2, CAST(NULL AS TIMESTAMP) AS avsec_t3, avsec_comments,
  baggage_claim_airline,
  baggage_claim_t1, baggage_claim_t2, baggage_claim_t3, baggage_claim_comments,
  passport_outbound_t1, passport_outbound_t2, CAST(NULL AS TIMESTAMP) AS passport_outbound_t3, passport_outbound_comments,
  passport_inbound_t1, passport_inbound_t2, CAST(NULL AS TIMESTAMP) AS passport_inbound_t3, passport_inbound_comments,
  border_protection_t1, border_protection_t2, CAST(NULL AS TIMESTAMP) AS border_protection_t3, border_protection_comments
FROM ${ref("mediciones_sheets")}
