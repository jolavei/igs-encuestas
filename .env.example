# Plantilla. Copia a .env y completa con TUS valores. NUNCA pongas secretos reales aquí
# (este archivo SÍ se versiona). El .env real está en .gitignore.

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:5432/BASE?schema=public"
# Nube (Supabase/Railway/Neon): usa el connection string del proveedor.

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# Genera uno: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo"

# --- Google OAuth (produccion) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft OAuth / Azure AD (Entra ID) ---
# Registra una app en Azure Portal > Entra ID > App registrations.
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/azure-ad
# (ej. http://localhost:3000/api/auth/callback/azure-ad y el de producción).
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Tenant: "common" (cualquier cuenta Microsoft) o el ID del tenant de tu
# organización para restringir solo a sus cuentas. Vacío = "common".
AZURE_AD_TENANT_ID="common"

# --- Yahoo OAuth (OpenID Connect) ---
# Registra una app en https://developer.yahoo.com/apps/create/
# - "Redirect URI(s)": <NEXTAUTH_URL>/api/auth/callback/yahoo
# - "API Permissions": marca "Profiles (Social Directory)" > Read/Read Public,
#   si no, Yahoo no entrega el email y el login queda en AccessDenied.
# OJO: Yahoo NO acepta localhost ni http en el Redirect URI: solo https con un
# dominio real. Para probar en local necesitas un túnel (ngrok, cloudflared) y
# apuntar NEXTAUTH_URL a esa URL https.
YAHOO_CLIENT_ID=""
YAHOO_CLIENT_SECRET=""

# --- Magic Link por correo (Resend) ---
# Passwordless: enlace de un solo uso al correo (vence en 30 min). Cubre a quien no
# usa Google/Microsoft/Yahoo. La whitelist protege el envío: a un correo no
# registrado no se le manda el enlace.
# 1) Crea una API key en https://resend.com (plan gratis ~3.000 correos/mes).
# 2) Para enviar desde tu dominio, verifícalo en Resend (registros DNS). Mientras
#    tanto puedes usar el remitente de prueba "onboarding@resend.dev".
RESEND_API_KEY=""
EMAIL_FROM="Aeródromos IGS <no-reply@aerodromosigs.cl>"
# Muestra el formulario de correo en la pantalla de login (público, no secreto).
NEXT_PUBLIC_ENABLE_EMAIL_LOGIN="true"

# --- Login de desarrollo (sin Google) ---
# "true" habilita login por email sin password para probar local. NUNCA en prod.
# En producción: OMITE ambas variables (o ponlas en "false").
ENABLE_DEV_LOGIN="true"
NEXT_PUBLIC_ENABLE_DEV_LOGIN="true"

# --- Email del primer admin (se promueve a ADMIN en el seed/primer login) ---
BOOTSTRAP_ADMIN_EMAIL="tu-correo@dominio.cl"

# --- BigQuery (Dashboard admin: lee encuestas.mediciones_tiempos_consolidado) ---
# La MISMA service account que usa la sincronización (bigquery-sync@), con permiso
# de lectura. En Vercel: agrega estas variables en Project Settings > Environment.
GCP_PROJECT_ID="igs-encuestas"
# JSON de la cuenta de servicio como una sola línea (pega el contenido del .json).
GCP_SA_KEY=""
# Ubicación del dataset (los datasets del pipeline están en US).
BQ_LOCATION="US"

# --- Scraper Compliance ASQ (scripts/scrape-asq.mjs) ---
# Credenciales del portal ACI-ASQ (https://smt.v2.asq.aci.aero). No las subas.
ASQ_USERNAME="r.delpiano"
ASQ_PASSWORD=""
# Opcionales (tienen defaults en el script):
# ASQ_BASE_URL="https://smt.v2.asq.aci.aero"
# ASQ_AIRPORTS="all"           # o "PMC,IQQ,CJC"
# ASQ_SEASONS="all"            # o "Summer-2026,Winter-2025-26"
# ASQ_BROWSER_CHANNEL="msedge" # navegador (Edge del sistema)
