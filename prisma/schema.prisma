// Plataforma encuestas CSAT/NPS — base operacional.
// Motor actual: PostgreSQL (local + produccion).
// Esquema PORTABLE: tipos String para "enums" y columnas JSON. Los valores permitidos
// de los campos de tipo "enum" se validan en la app (zod). Esto permite, si se quiere,
// correr el mismo esquema en SQLite cambiando provider a "sqlite" + url file:./dev.db.
// Respuestas en FORMATO LARGO: una fila por respuesta a una pregunta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth (NextAuth + roles). Rol se resuelve server-side, nunca desde el cliente.
// role: ADMIN | SURVEYOR | CLIENT
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("SURVEYOR")
  active        Boolean   @default(true) // false = usuario antiguo desactivado (no puede entrar)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  locationId    String? // si CLIENT: sede específica que puede consultar (documentos)
  location      Location? @relation("ClientLocation", fields: [locationId], references: [id])
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  workPlans   WorkPlan[]    @relation("WorkPlanSurveyors")
  responses   ResponseSet[] @relation("SurveyorResponses")
  auditLogs   AuditLog[]

  @@index([companyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// Negocio
// ----------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  kind      String // "hotel" | "aeropuerto" | "clinica" | ...
  active    Boolean  @default(true) // false = cliente pasado/desactivado (conserva histórico)
  createdAt DateTime @default(now())

  locations      Location[]
  users          User[]
  questionnaires Questionnaire[] @relation("CompanyQuestionnaires")
  workPlans      WorkPlan[]
  folders        Folder[]
  documents      Document[]
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  address   String?
  createdAt DateTime @default(now())

  qrTokens    QrToken[]
  responses   ResponseSet[]
  workPlans   WorkPlan[]
  clients     User[]        @relation("ClientLocation")
  folders     Folder[]
  documents   Document[]

  @@index([companyId])
}

// Contenedor logico. Tiene N versiones (snapshots inmutables).
// Se puede asignar a VARIAS empresas (mismo cuestionario -> benchmarking cruzado).
model Questionnaire {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())

  companies   Company[]              @relation("CompanyQuestionnaires")
  versions    QuestionnaireVersion[]
  workPlans   WorkPlan[]
  qrTokens    QrToken[]
}

// Snapshot inmutable. Una vez ACTIVE no se editan sus preguntas: se crea nueva version.
// status: DRAFT | ACTIVE | ARCHIVED
model QuestionnaireVersion {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  versionNumber   Int
  status          String        @default("DRAFT")
  publishedAt     DateTime?
  createdById     String?
  note            String? // comentario: qué cambió en esta versión y por qué
  createdAt       DateTime      @default(now())

  questions Question[]
  sections  QuestionSection[]
  responses ResponseSet[]

  @@unique([questionnaireId, versionNumber])
  @@index([questionnaireId, status])
}

// Sección de un cuestionario (estilo Google Forms). Al final de cada sección se
// decide a dónde ir: NEXT (siguiente), SUBMIT (enviar) o GOTO:<order> (una sección
// específica). Pertenecen a una VERSION (inmutable): editar = nueva versión.
model QuestionSection {
  id          String               @id @default(cuid())
  versionId   String
  version     QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  order       Int
  title       String               @default("")
  description String?
  routing     String               @default("NEXT") // "NEXT" | "SUBMIT" | "GOTO:<order>"

  questions Question[]

  @@index([versionId])
}

// Pertenecen a una VERSION, no al cuestionario abstracto.
// type: LIKERT | NPS | SINGLE_CHOICE | MULTI_CHOICE | TEXT | DATETIME | NUMBER
model Question {
  id        String               @id @default(cuid())
  versionId String
  version   QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sectionId String? // sección a la que pertenece (null en versiones antiguas)
  section   QuestionSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  order     Int
  type      String
  text      String
  required  Boolean              @default(false)
  // Validacion/config por tipo (JSON como texto): { min, max, step, maxLength, options, multi }
  config    String?
  // Para comparar series de tiempo entre versiones aunque cambie el cuestionario.
  equivalenceKey String?
  // Mapeo a BigQuery (Dataform): columna de la tabla ancha por cuestionario.
  bqColumnName   String? // nombre de la columna en BigQuery
  bqType         String? // tipo de dato BQ: STRING | INT64 | FLOAT64 | NUMERIC | BOOL | DATE | TIMESTAMP
  bqDescription  String? // detalle / a qué hace referencia

  answers Answer[]

  @@index([versionId])
  @@index([equivalenceKey])
}

// Plan de trabajo: meta compartida (empresa + cuestionario + ventana de tiempo).
// Meta total mínima N (se puede superar) + sub-metas por segmento (aerolínea/destino).
// Suman a la meta los levantamientos de encuestadores asignados y de admins (no el QR).
// status: ACTIVE | COMPLETED | CANCELLED
model WorkPlan {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  locationId      String? // sede fija (opcional); si null, el encuestador la elige
  location        Location?     @relation(fields: [locationId], references: [id])
  windowStart     DateTime
  windowEnd       DateTime
  totalTarget     Int           @default(0) // N mínimo total
  // Segmento primario (nivel 1) = respuesta a la pregunta con este equivalenceKey.
  segmentKey      String?
  segmentLabel    String? // "Proceso" / "Aerolínea" (para mostrar)
  // Segmento secundario (nivel 2), opcional: sub-metas dentro de cada valor del primario.
  segment2Key     String?
  segment2Label   String?
  comment         String?
  status          String        @default("ACTIVE")
  createdById     String?
  createdAt       DateTime      @default(now())

  segments  WorkPlanSegment[]
  surveyors User[]            @relation("WorkPlanSurveyors")
  responses ResponseSet[]

  @@index([companyId])
  @@index([questionnaireId])
}

// Sub-meta. Nivel 1 (proceso): parentValue = null. Nivel 2 (aerolínea dentro de un
// proceso): parentValue = valor del segmento primario. Ej: {parentValue:"checkin",
// value:"LATAM", target:50}.
model WorkPlanSegment {
  id          String   @id @default(cuid())
  workPlanId  String
  workPlan    WorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  parentValue String? // null = nivel 1; si no, el valor del segmento primario al que pertenece
  value       String // valor de la opción (coincide con la respuesta)
  label       String
  target      Int      @default(0)

  @@index([workPlanId])
}

// Un envio de encuesta (un respondente). Referencia la VERSION con la que se capturo.
// source: FIELD | QR_PUBLIC
model ResponseSet {
  id           String               @id @default(cuid())
  versionId    String
  version      QuestionnaireVersion @relation(fields: [versionId], references: [id])
  locationId   String?
  location     Location?            @relation(fields: [locationId], references: [id])
  source       String
  surveyorId   String?
  surveyor     User?                @relation("SurveyorResponses", fields: [surveyorId], references: [id])
  workPlanId    String?
  workPlan      WorkPlan?           @relation(fields: [workPlanId], references: [id])
  segmentValue  String? // valor del segmento primario (nivel 1)
  segmentValue2 String? // valor del segmento secundario (nivel 2), si el plan lo usa
  // Trazabilidad de sync a BigQuery (batch). null = pendiente.
  syncedAt     DateTime?
  createdAt    DateTime             @default(now())

  answers Answer[]

  @@index([versionId])
  @@index([locationId])
  @@index([workPlanId])
  @@index([syncedAt])
}

// FORMATO LARGO: una fila por respuesta a una pregunta.
model Answer {
  id            String      @id @default(cuid())
  responseSetId String
  responseSet   ResponseSet @relation(fields: [responseSetId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id])
  // Un valor segun tipo: numero (LIKERT/NPS/NUMBER), texto (TEXT/SINGLE_CHOICE),
  // fecha (DATETIME), json-texto (MULTI_CHOICE -> array de valores).
  valueNumber   Float?
  valueText     String?
  valueDate     DateTime?
  valueJson     String?

  @@index([responseSetId])
  @@index([questionId])
}

// Token QR ESTABLE por sede+cuestionario. Resuelve la version ACTIVE en runtime,
// asi una nueva version no invalida el QR ya impreso en el hotel.
model QrToken {
  id              String        @id @default(cuid())
  token           String        @unique
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([questionnaireId, locationId])
}

// Registro de la última sincronización a BigQuery (lo escribe el script de sync
// al terminar con éxito; el panel admin muestra la última hora).
model SyncLog {
  id       String   @id @default(cuid())
  target   String   @default("bigquery")
  tables   Int      @default(0)
  rows     Int      @default(0)
  syncedAt DateTime @default(now())

  @@index([syncedAt])
}

// ----------------------------------------------------------------------------
// Documentos: repositorio tipo Drive. Admin sube; cliente (por sede) consulta.
// ----------------------------------------------------------------------------

// Carpeta (anidable). Alcance: empresa + sede opcional.
model Folder {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  parentId    String?
  parent      Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children    Folder[] @relation("FolderTree")
  name        String
  createdById String?
  createdAt   DateTime @default(now())

  documents Document[]

  @@index([companyId, locationId])
  @@index([parentId])
}

// Archivo. El binario vive en Google Cloud Storage (objectPath); descarga por URL firmada.
model Document {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  folderId     String?
  folder       Folder?  @relation(fields: [folderId], references: [id])
  name         String
  objectPath   String // ruta del objeto en el bucket de GCS
  contentType  String
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([companyId, locationId])
  @@index([folderId])
}

// ----------------------------------------------------------------------------
// Compliance ASQ: datos extraídos del portal ACI-ASQ (Survey Management Tool)
// por el scraper (scripts/scrape-asq.mjs). Un "run" = una combinación
// aeropuerto + temporada; "solo el más reciente": reejecutar reemplaza sus filas.
// ----------------------------------------------------------------------------

model AsqComplianceRun {
  id          String   @id // randomUUID desde el script
  airport     String // código del desplegable de ASQ (PMC, IQQ, CJC, ...)
  season      String // "SUMMER" | "WINTER" (parseado de la etiqueta)
  seasonLabel String // "Summer-2026" | "Winter-2025-26" (como aparece en ASQ)
  year        Int // año de inicio de la temporada (2026 / 2025)
  terminal    String   @default("ALL")
  surveyType  String   @default("DEPARTURES")
  period      String   @default("REGIONAL")
  scrapedAt   DateTime @default(now())

  rows AsqComplianceRow[]

  @@unique([airport, seasonLabel]) // clave de upsert: solo el más reciente
  @@index([seasonLabel])
}

model AsqComplianceRow {
  id                 String           @id
  runId              String
  run                AsqComplianceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  airlineDestination String // "LA-SCL"
  airlineCode        String? // "LA"
  destinationCode    String? // "SCL"
  target             Int // Questionnaires Original Target (plan de trabajo)
  collected          Int // encuestas realizadas

  @@index([runId])
}

// Auditoria: quien creo/edito version y quien asigno cuota.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  String? // JSON como texto
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
